{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build Filesystem Image",
      "type": "process",
      "command": "mise",
      "args": ["run", "build-fs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Upload Filesystem Image",
      "type": "process",
      "command": "mise",
      "args": ["run", "upload-fs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
